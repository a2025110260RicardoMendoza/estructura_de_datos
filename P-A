    MAIN
==================================================*/
int main() {

    srand(time(NULL));

    /*====================================
        USUARIOS
    ====================================*/

    Usuario admin(
        "Carlos",
        "123",
        "admin",
        "1234",
        "Administrador",
        "N/A"
    );

    Usuario ingeniero(
        "Luis",
        "456",
        "ing",
        "1234",
        "Ingeniero",
        "Ingeniero de Automatizacion"
    );

    Usuario cliente(
        "Pedro",
        "789",
        "cliente",
        "1234",
        "Cliente",
        "N/A"
    );

    /*====================================
        LOGIN
    ====================================*/

    string user;
    string pass;

    cout << "===== LOGIN =====\n";

    cout << "Usuario: ";
    cin >> user;

    cout << "Password: ";
    cin >> pass;

    Usuario* usuarioActivo = NULL;

    if (admin.login(user, pass)) {
        usuarioActivo = &admin;
    }
    else if (ingeniero.login(user, pass)) {
        usuarioActivo = &ingeniero;
    }
    else if (cliente.login(user, pass)) {
        usuarioActivo = &cliente;
    }

    if (usuarioActivo == NULL) {

        cout << "Acceso denegado\n";
        return 0;
    }

    cout << "\nBienvenido "
         << usuarioActivo->getNombre()
         << endl;

    cout << "Rol: "
         << usuarioActivo->getRol()
         << endl;

    if (usuarioActivo->getRol() == "Ingeniero") {

        cout << "Cargo: "
             << usuarioActivo->getCargoIngeniero()
             << endl;
    }

    /*====================================
        MULTILISTA
    ====================================*/

    Multilista sistema;

    Empresa* e1 = new Empresa(1, "Tesla");
    Planta* p1 = new Planta(1, "Planta Norte");

    Maquina* m1 = new Maquina(1, "Brazo Robotico A");
    Maquina* m2 = new Maquina(2, "Brazo Robotico B");

    p1->agregarMaquina(m1);
    p1->agregarMaquina(m2);

    e1->agregarPlanta(p1);

    sistema.agregarEmpresa(e1);

    sistema.mostrarEmpresas();

    /*====================================
        TELEMETRIA
    ====================================*/

    priority_queue<Alerta> colaAlertas;

    Maquina* actual = p1->listaMaquinas;

    while (actual != NULL) {

        actual->simularTelemetria();

        actual->mostrarEstado();

        actual->guardarLog();

        if (actual->getTemperatura() > 100) {

            colaAlertas.push(
                Alerta(
                    10,
                    "Temperatura critica en "
                    + actual->getNombre()
                )
            );
        }

        actual = actual->siguiente;
    }

    /*====================================
        ALERTAS
    ====================================*/

    cout << "\n===== ALERTAS =====\n";

    while (!colaAlertas.empty()) {

        cout
            << colaAlertas.top().mensaje
            << endl;

        colaAlertas.pop();
    }

    cout << "\nSistema finalizado\n";

    return 0;
}
